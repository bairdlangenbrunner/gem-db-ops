Table steel_yearly_production {
  id int8 [pk]
  year int4
  "productionDatasource" jsonb
  "otherSteelProductionQualifier" varchar
  "totalSteelProduction" numeric
  "BOFSteelProdQualifier" varchar
  "BOFSteelProd" numeric
  "EAFSteelProdQualifier" varchar
  "EAFSteelProd" numeric
  "OHFSteelProdQualifier" varchar
  "OHFSteelProd" numeric
  plant_id int8 [not null]
  "otherSteelProduction" numeric
  "IFSteelProd" numeric
  "IFSteelProdQualifier" varchar
}

Table technology {
  id int8 [pk]
  name text [not null]
}

Table technology_fuel_category {
  id int4 [pk]
  technology_id int8 [not null]
  fuelcategory_id int8 [not null]
}

Table thread {
  id int8 [pk]
  completed bool [not null]
  element text
  deleted bool [not null]
  assignee_id int4
  project_id int8
  created timestamptz [not null]
  modified timestamptz [not null]
  entity_id int8
}

Table turbine_manufacturer {
  id int8 [pk]
  option text
  deleted bool [not null]
}

Table ultimate_parent_rationale {
  id int8 [pk]
  option text
}

Table unit_external_id {
  id int8 [pk]
  "externalId" text
  "idSystem_id" int8
  unit_id int8
}

Table unit_fuel {
  id int8 [pk]
  category_id int8
  detail_id int8
  powerplant_unit_id int8
  primary bool
  percentage numeric
  "startYear" text
  status_id int8
  timepoint text
}

Table unit_replacement {
  id int8 [pk]
  "unitReplacementId" int8
  unit_id int8

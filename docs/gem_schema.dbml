  "unitReplacementDatasource" jsonb
}

Table unit_replacement_type {
  id int8 [pk]
  option text
}

Table unit_turbine {
  id int8 [pk]
  model text
  "turbineManufacturer_id" int8
  unit_id int8
}

Table unit_update {
  id int8 [pk]
  "lastUpdated" date
  "researchStatus_id" int8
  updater_id int4
  unit_id int8
}

